<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- The plugin is dropped into the uWidgets "Widgets" folder. -->
        <OutputPath>dist\Widgets</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <ItemGroup>
      <!-- Compile-time only: the host application provides Avalonia at runtime. -->
      <PackageReference Include="Avalonia" Version="11.1.3" PrivateAssets="all" ExcludeAssets="runtime">
        <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Avalonia.ReactiveUI" Version="11.1.3" PrivateAssets="all" ExcludeAssets="runtime">
        <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <!--
        uWidgets.Core is referenced for compile time only. The host resolves the
        assembly from its own loaded assemblies, so type identity is preserved.
        vendor/uWidgets.Core is a pinned mirror of the upstream sources; point this
        ProjectReference at your own clone instead if you have one.
      -->
      <ProjectReference Include="vendor\uWidgets.Core\uWidgets.Core.csproj">
        <Private>false</Private>
        <ExcludeAssets>runtime</ExcludeAssets>
      </ProjectReference>
    </ItemGroup>

    <ItemGroup>
      <!-- The vendored Core sources are compiled into uWidgets.Core, not into the plugin. -->
      <Compile Remove="vendor\**\*.cs" />
      <Compile Remove="_scratch\**\*.cs" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Locales\Locale.resx">
        <Generator>PublicResXFileCodeGenerator</Generator>
        <LastGenOutput>Locale.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Locales\Locale.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Locale.resx</DependentUpon>
        <Generator>PublicResXFileCodeGenerator</Generator>
      </Compile>
    </ItemGroup>

</Project>
